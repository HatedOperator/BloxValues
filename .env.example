# ── Required ────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=your-bot-token-here

# Application ID from https://discord.com/developers/applications → General Information
CLIENT_ID=your-application-id-here

# ── Stock updates ───────────────────────────────────────────────────────────
# Channel ID where Normal/Mirage stock updates are auto-posted.
# You can also set (or override) this per server with /setstockchannel.
STOCK_CHANNEL_ID=

# Optional role ID pinged whenever a stock rotation is posted.
STOCK_MENTION_ROLE_ID=

# ── Optional tuning ─────────────────────────────────────────────────────────
# Guild ID: if set, slash commands register instantly to that one server
# (otherwise they register globally, which can take up to an hour).
GUILD_ID=

# How often (seconds) to poll the stock API. Default: 60.
STOCK_POLL_SECONDS=60

# Post the current stock once when the bot starts up. Default: true.
POST_ON_STARTUP=true

# Accent color for embeds that have no rarity color. Default: 0x2b2d31.
EMBED_COLOR=0x2b2d31

# Where the bot stores per-server settings and watcher state.
# On Railway/containers, point this at your volume mount (e.g. /data).
# Default: <repo>/data
DATA_DIR=
