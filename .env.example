# ── Required ────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=your-bot-token-here

# Application ID from https://discord.com/developers/applications → General Information
CLIENT_ID=your-application-id-here

# ── Optional ────────────────────────────────────────────────────────────────
# Channel that always shows the live stock message (the bot deletes the old
# stock post and sends the current one on startup and after every rotation).
# Defaults to the built-in channel ID if unset.
STOCK_CHANNEL_ID=1549345099543093258

# Optional role ID pinged ONLY when a stock rotation contains rare/good fruit
# (Legendary/Mythical or high trade value). Leave empty for ping-less alerts.
STOCK_PING_ROLE_ID=

# Accent color for embeds that have no rarity color. Default: 0x2b2d31.
EMBED_COLOR=0x2b2d31

# Where the bot stores watcher state. On Railway/containers, point this at
# your volume mount (e.g. /data). Default: <repo>/data
DATA_DIR=
